{% extends 'base.twig' %}

{% block content %}
{% include 'partials/no-hero.twig' %}

<div class="herd-profiles-page" id="content" tabindex="-1">
	{% if listing_html %}
		<header class="page-header">
			<h1 class="entry-title herd-profiles-page__title">{{ page_title }}</h1>
			{% if archive_description %}
				<div class="archive-description">{{ archive_description|raw }}</div>
			{% endif %}
		</header>

		{{ listing_html|raw }}
	{% endif %}
</div>
{% endblock %}
