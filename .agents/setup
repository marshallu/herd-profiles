#!/usr/bin/env bash
set -euo pipefail

run_step() {
	local label="$1"
	local started_at=$SECONDS
	shift

	printf '\n==> %s\n' "$label"
	"$@"
	printf '<== %s (%ss)\n' "$label" "$(( SECONDS - started_at ))"
}

required_packages=(composer php-cli php-curl php-xml)
missing_packages=()

for package in "${required_packages[@]}"; do
	if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -Fqx 'installed'; then
		missing_packages+=("$package")
	fi
done

if (( ${#missing_packages[@]} > 0 )); then
	run_step "Update apt package metadata" sudo -n apt-get update
	run_step "Install system dependencies" sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
else
	printf 'System dependencies are already installed.\n'
fi

run_step "Install Node dependencies" npm ci --no-audit --no-fund
run_step "Install Git hooks" ./node_modules/.bin/lefthook install
run_step "Install Composer dependencies" composer install --no-interaction --prefer-dist --no-progress

printf '\nOrb setup complete.\n'
