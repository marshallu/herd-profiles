<?xml version="1.0"?>
<ruleset name="WordPress VIP Coding Standards">
    <description>WordPress VIP Coding Standards for PHP files in the project.</description>
    <config name="testVersion" value="7.2-"/>
    <rule ref="WordPress-VIP-Go"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Paths to exclude from the scan -->
    <exclude-pattern>/acf-fields.php</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/css/*</exclude-pattern>
    <exclude-pattern>/source/*</exclude-pattern>

    <!-- Paths to scan -->
    <file>.</file>
</ruleset>
